# Optional override (default: data/career_search.db). Pytest forces data/test.db automatically.
# DATABASE_URL=sqlite:///./data/career_search.db

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Required for signed session cookies (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# Allow /register after the first user exists (dev only)
ALLOW_REGISTRATION=false

# Set true when deployed behind HTTPS
SESSION_HTTPS_ONLY=false
